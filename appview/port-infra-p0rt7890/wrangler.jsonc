{
  "name": "kotodama-p0rt7890",
  "main": "./src/app.ts",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "vars": {
    "APP_CAPABILITIES": "[\"bpmn-dispatch\",\"port-registry\",\"port-call-tracking\",\"maritime-intelligence\"]",
    "APP_DESCRIPTION": "World port infrastructure, berths, terminals, vessel call tracking",
    "APP_DISPLAY_NAME": "Port Infrastructure (port.etzhayyim.com)",
    "APP_FRAMEWORK": "shadow-cljs-edge-bff",
    "APP_NANOID": "p0rt7890",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "yoro",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message"
  },
  "routes": [
    {
      "pattern": "p0rt7890.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    },
    {
      "pattern": "port.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    }
  ],
  "assets": {
    "directory": "../../web/dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
